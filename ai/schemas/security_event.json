{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentinelFlow Security Event",
  "description": "Normalized security event schema for SentinelFlow",

  "type": "object",

  "required": [
    "event_id",
    "timestamp",
    "event_type",
    "actor",
    "source",
    "target",
    "severity",
    "metadata"
  ],

  "properties": {
    "event_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "event_type": {
      "type": "string",
      "enum": [
        "login_failed",
        "login_success",
        "privilege_escalation",
        "suspicious_request",
        "resource_access",
        "password_change",
        "MFA_change",
        "new_device"
      ]
    },

    "actor": {
      "type": "object",
      "required": [
        "user_id",
        "username"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "required": [
        "ip",
        "device_id"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },

        "device_id": {
          "type": "string"
        },

        "user_agent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },

    "target": {
      "type": "object",
      "required": [
        "service",
        "resource"
      ],
      "properties": {
        "service": {
          "type": "string"
        },

        "resource": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },

    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },

    "metadata": {
      "type": "object"
    }
  },

  "additionalProperties": false
}